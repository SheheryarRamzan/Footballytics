# Copy to .env and fill in from `azd env get-values` (or the Bicep deployment outputs).
# No API keys: all Azure access is keyless (Entra ID). Run `az login` locally.
FOUNDRY_PROJECT_ENDPOINT=https://<account>.services.ai.azure.com/api/projects/footballytics
AZURE_OPENAI_ENDPOINT=https://<account>.openai.azure.com
AZURE_AI_ENDPOINT=https://<account>.services.ai.azure.com
MODEL_REASONING=gpt-5-mini
MODEL_FAST=gpt-4.1-mini
MODEL_REALTIME=gpt-realtime-mini
MODEL_TTS=gpt-4o-mini-tts
ANALYST_MODEL=reasoning
ANALYST_EFFORT=minimal
NEWSROOM_MIN_IMPORTANCE=50
